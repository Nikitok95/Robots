# Copy to .env and fill in. Keys are read only by the backend container.

# --- Required -------------------------------------------------------------
# FRED: US yields, TIPS, 2s10s, 5Y5Y, EFFR, Fed target range, VIX, Nasdaq 100
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# SoSoValue: daily net flows of US spot BTC ETFs
# Free key: https://sosovalue.com/developer
SOSOVALUE_API_KEY=
# Endpoint (change if SoSoValue moves its API; check with `python -m app.verify`)
SOSOVALUE_ETF_URL=https://api.sosovalue.xyz/openapi/v2/etf/historicalInflowChart

# --- Optional -------------------------------------------------------------
# CoinGecko demo key (higher rate limits; keyless works too)
COINGECKO_API_KEY=
# Paid providers: PMI, wage growth and a wider economic calendar
TRADINGECONOMICS_API_KEY=
FMP_API_KEY=

# --- Schedules (cron, Europe/Madrid) ----------------------------------------
REFRESH_CRON_MARKETS=30 7,23 * * *
REFRESH_CRON_CRYPTO=5 * * * *
REFRESH_CRON_MACRO=0 6 * * *
REFRESH_ON_STARTUP=true

# Host port for the web UI
WEB_PORT=8080
